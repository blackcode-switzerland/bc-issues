{
  "name": "@blackcode/platform-db",
  "version": "0.0.0",
  "description": "Shared Drizzle schema and client factory for the platform tables every Blackcode app uses.",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./client": "./src/client.ts",
    "./app-access": "./src/app-access.ts",
    "./urn": "./src/urn.ts",
    "./entities": "./src/entities.ts",
    "./links": "./src/links.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "typescript": "^5.6.2",
    "@typescript-eslint/parser": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "eslint": "^8.57.0"
  }
}
