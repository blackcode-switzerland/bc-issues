{
  "name": "@blackcode/platform-storage",
  "version": "0.0.0",
  "description": "Shared blob storage: the upload ledger, app-prefixed paths, the per-app reference-scanner registry, and the garbage collector that will not delete a file any app still references.",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./apps": "./src/apps.ts",
    "./assets": "./src/assets.ts",
    "./paths": "./src/paths.ts",
    "./references": "./src/references.ts",
    "./gc": "./src/gc.ts",
    "./uploads": "./src/uploads.ts",
    "./limits": "./src/limits.ts",
    "./attribution": "./src/attribution.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@blackcode/platform-db": "*",
    "@vercel/blob": "^0.23.4",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "typescript": "^5.6.2",
    "@typescript-eslint/parser": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "eslint": "^8.57.0"
  }
}
